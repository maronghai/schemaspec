{
  "name": "rune-schema",
  "displayName": "Rune Schema Language",
  "description": "Syntax highlighting, IntelliSense, and language support for Rune .ss schema files",
  "version": "0.280.0",
  "publisher": "rune-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "schema",
    "database",
    "sql",
    "dsl",
    "ddl",
    "migration",
    "rune"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rune-lang/rune.git"
  },
  "bugs": {
    "url": "https://github.com/rune-lang/rune/issues"
  },
  "activationEvents": [
    "onLanguage:rune"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rune",
        "aliases": [
          "Rune",
          "rune",
          "rune-schema"
        ],
        "extensions": [
          ".ss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rune",
        "scopeName": "source.rune",
        "path": "./syntaxes/rune.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rune.validate",
        "title": "Rune: Validate Schema"
      },
      {
        "command": "rune.generate",
        "title": "Rune: Generate SQL"
      },
      {
        "command": "rune.init",
        "title": "Rune: Initialize Schema"
      }
    ],
    "configuration": {
      "title": "Rune Schema Language",
      "properties": {
        "rune.schemaPath": {
          "type": "string",
          "default": "rune",
          "description": "Path to the rune binary. Use an absolute path if rune is not in your PATH."
        },
        "rune.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Rune language server for completion, hover, go-to-definition, and diagnostics."
        }
      }
    }
  }
}
