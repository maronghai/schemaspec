{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "base",
  "type": "object",
  "$defs": {
    "post": {
      "type": "object",
      "properties": {
        "title": {"type":"string"}
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "properties": {
        "post_id": {"type":"integer"},
        "body": {"type":"string"}
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "properties": {
    "post": { "$ref": "#/$defs/post" },
    "comment": { "$ref": "#/$defs/comment" }
  },
  "required": ["post", "comment"]
}
