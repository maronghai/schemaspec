{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rune-schema",
  "type": "object",
  "$defs": {
    "order": {
      "type": "object",
      "description": ": 订单表",
      "properties": {
        "id": {"type":"integer"},
        "user_id": {"type":"integer"},
        "total": {"type":"string","format":"date"},
        "status": {"type":"string"},
          "enum": ["draft", "pending", "done"]
      },
      "required": [],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "description": ": 用户表",
      "properties": {
        "id": {"type":"integer"},
        "name": {"type":"string"}
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "properties": {
    "order": { "$ref": "#/$defs/order" },
    "user": { "$ref": "#/$defs/user" }
  },
  "required": ["order", "user"]
}
